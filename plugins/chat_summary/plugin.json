{
  "name": "chat_summary",
  "api": "v1",
  "description": "使用配置的大模型总结当前群成员或全群当天聊天",
  "entry": "__init__.py",
  "requires": [
    "group.text.receive",
    "group.text.send"
  ],
  "scheduled_actions": [
    {
      "id": "group_summary",
      "label": "总结群聊",
      "method": "scheduled_group_summary",
      "fields": [{"name": "chat_id", "label": "群 ID", "type": "chat", "required": true}]
    }
  ],
  "business": [
    {
      "function": "Plugin.reply_summary",
      "label": "生成并回复总结"
    }
  ],
  "llm": true,
  "config": {
    "source": "bot_config",
    "sections": [
      {
        "title": "总结",
        "fields": [
          {
            "key": "chunk_chars",
            "label": "分批字符数",
            "type": "int",
            "default": 16000,
            "range": [
              4000,
              64000
            ],
            "help": "总结时每批送进模型的聊天文本字符上限，默认 16000。值越大每批装的记录越多、请求次数越少；可填 4000–64000 的整数。"
          },
          {
            "key": "summary_fallback_model",
            "label": "备用总结模型",
            "type": "text",
            "default": "",
            "help": "群聊总结使用主模型失败时改用的模型 ID，例如 deepseek-ai/deepseek-v4.1-flash。留空表示不启用备用模型。备用模型按「不思考、不带 tools」调用，要选能直接给出正文的模型。"
          }
        ]
      }
    ]
  },
  "concurrency": "serial",
  "max_concurrency": 4
}
