{
  "backend": "native_text",
  "chat_allowlist": [],
  "image_directory": ".runtime/images",
  "file_directory": ".runtime/files",
  "emoticon_directory": ".runtime/emoticons",
  "wechat_data_directory": null,
  "wechat_pid": null,
  "wechat_account": null,
  "admins": [],
  "admin_token": "",
  "admin_commands": ["/总结", "/总结群聊", "/切换人格"],
  "reconnect_seconds": 5,
  "plugin_queue_size": 128,
  "console": true,
  "wechat_names": {
    "enabled": true,
    "refresh_seconds": 300
  },
  "log_level": "INFO",
  "admin": {
    "enabled": true,
    "port": 0,
    "host": "127.0.0.1",
    "allowed_hosts": ["127.0.0.1", "localhost", "::1"]
  },
  "llm_config_file": "llm_config.json",
  "tts_config_file": "tts_config.json",
  "members_config_file": "members_config.json",
  "text_send_delay": {
    "enabled": true,
    "short_text_max_chars": 30,
    "min_seconds": 0.5,
    "max_seconds": 2.0
  },
  "plugins": {
    "anti_recall": {
      "enabled": true
    },
    "anti_recall_image": {
      "enabled": true
    },
    "anti_recall_file": {
      "enabled": true
    },
    "anti_recall_voice": {
      "enabled": true
    },
    "picture_idiom": {
      "enabled": false,
      "source": "ffapi",
      "timeout_seconds": 8,
      "wrong_reply_cooldown_seconds": 3
    },
    "voice_reply": {
      "enabled": false
    },
    "group_notice": {
      "enabled": false,
      "welcome": true,
      "leave_notice": true,
      "welcome_template": "欢迎 {nickname} 加入群聊！",
      "leave_template": "{nickname} 离开了群聊。"
    },
    "friend_auto_accept": {
      "enabled": false,
      "verification_keywords": []
    },
    "personality": {
      "enabled": true
    },
    "mention_chat": {
      "enabled": false
    },
    "chat_summary": {
      "enabled": false
    },
    "chat_records": {
      "enabled": true
    },
    "member_identity": {
      "enabled": true
    },
    "idiom_chain": {
      "enabled": false,
      "member_names": {}
    },
    "id_responder": {
      "enabled": true
    },
    "echo": {
      "enabled": true,
      "prefix": "echo "
    },
    "admin_bind": {
      "enabled": true
    },
    "image_gallery": {
      "enabled": true,
      "source": "xxapi",
      "commands": [
        "/来张图",
        "/美女"
      ],
      "cooldown_seconds": 10,
      "timeout_seconds": 12,
      "max_image_bytes": 10485760
    }
  }
}
